{
  "name": "axura-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "migrate": "node --env-file=.env.local --import tsx/esm lib/db/migrate.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "reset": "tsx --env-file=.env.local scripts/reset.ts",
    "smoke": "node --env-file=.env.local --import tsx/esm scripts/smoke-test.ts",
    "audit": "npm audit --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/s3-request-presigner": "^3.1005.0",
    "@neondatabase/serverless": "^1.0.2",
    "@react-pdf/renderer": "^4.3.0",
    "@sentry/node": "^9.0.0",
    "jose": "^6.1.3",
    "next": "^16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^4.5.1",
    "unpdf": "^1.4.0",
    "yaml": "^2.8.0",
    "zod": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.6"
  }
}
